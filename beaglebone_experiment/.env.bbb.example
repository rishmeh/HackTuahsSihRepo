# IP address of the laptop running `bash run.sh`.
LAPTOP_URL=http://192.168.1.100:8000

# USB UVC camera attached to the BBB USB-A host port.
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# Native ST7789 SPI IPS-panel resolution.
DISPLAY_WIDTH=240
DISPLAY_HEIGHT=240
DISPLAY_ROTATION=0
DISPLAY_BGR=false
DISPLAY_COL_OFFSET=0
DISPLAY_ROW_OFFSET=0
# GPIO pin for DC/RS (P9_15 = GPIO 48). P9_12 conflicts with HDMI.
DISPLAY_DC_GPIO=48

# Conservative MG90S pulse bounds in microseconds. Adjust only after testing.
HEAD_MIN_US=1000
HEAD_MAX_US=2000
BODY_MIN_US=1000
BODY_MAX_US=2000
