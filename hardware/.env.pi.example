# Copy to .env.pi on the Raspberry Pi.
# LAPTOP_URL defaults to mDNS — uncomment and set a static IP only if mDNS
# resolution fails on your network (some managed switches block mDNS multicast).
# LAPTOP_URL=http://192.168.1.100:8000
LAPTOP_URL=http://tabletot-laptop.local:8000

# USB camera (default). Change to csi or auto if you have a Pi CSI camera.
CAMERA_TYPE=usb
CAMERA_INDEX=0

# Display backend: hdmi (Pygame) or st7789v (pictured 240x320 SPI GMT020-02-8P).
DISPLAY_DRIVER=st7789v

# Used only when DISPLAY_DRIVER=hdmi.
DISPLAY_WIDTH=800
DISPLAY_HEIGHT=480
DISPLAY_FULLSCREEN=true

# Raspberry Pi 5-compatible GPIO Zero backend.
GPIOZERO_PIN_FACTORY=lgpio

# Head-tracking: when true the bridge calls servos.track(pan, tilt) on every
# frame response from the laptop, keeping the head pointed at the detected face.
# Set to false to disable tracking and use only the named gesture states.
TRACKING_MODE=true
