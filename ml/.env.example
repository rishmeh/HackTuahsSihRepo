# Copy this file to .env and fill in your values.
#
# Every setting here has a working default in config.py, so the server starts
# with no .env at all — but the endpoints that need Ollama or a cloud key will
# return fallbacks until those are configured.

# === Local SLM (Ollama) ===
# Install Ollama from https://ollama.com, then:
#   ollama pull qwen3:0.6b        (chat + flashcards)
#   ollama pull llava-phi3        (image questions, /chat/vision)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_VISION_MODEL=llava-phi3
OLLAMA_TIMEOUT=60
OLLAMA_THINK=false
OLLAMA_THINK_TIMEOUT=120

# === Escalation ===
# What happens when the SLM has low confidence or asks to escalate:
#   model_thinking — retry the local SLM with reasoning on (no key, works offline)
#   openrouter     — forward to the cloud (needs OPENROUTER_API_KEY below)
ESCALATION_MODE=model_thinking
# SLM confidence below this triggers escalation (0.0 - 1.0)
ESCALATION_CONFIDENCE_THRESHOLD=0.6

# === Cloud LLM (OpenRouter) ===
# Needed for /quiz, and for ESCALATION_MODE=openrouter. Get a key at
# https://openrouter.ai. Never receives student PII - the sanitizer strips it first.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_TIMEOUT=30

# === Conversation history ===
# Max past turns (user + assistant pairs) kept per session, in memory
MAX_HISTORY_TURNS=10

# === Safety ===
MAX_QUERY_LENGTH=2000
MAX_RESPONSE_LENGTH=4000

# === Vision: face detection (YuNet) and recognition (SFace) ===
# Fetch the models once with: python -m vision.download_models
# Detector confidence. Calibrated: a moving face scores ~0.83, while the worst
# false positive on a faceless image scored 0.585. Raising this towards 0.9
# loses the student whenever they move.
FACE_DETECT_THRESHOLD=0.70
# Cosine similarity required to accept an identity. Same person ~0.94,
# different people ~0.20, so 0.45 sits in the gap.
FACE_MATCH_THRESHOLD=0.45
# Consecutive agreeing frames before announcing arrival / departure
FACE_CONFIRM_FRAMES=3
FACE_FORGET_FRAMES=5
# Webcam index for cv2.VideoCapture
CAMERA_INDEX=0
VISION_FPS=5
